{
    "version": "2.0.0",
    "tasks": [
    {
    "label": "Build C++ file",
    "type": "process",
    "command": "/usr/bin/clang++",
    "args": [
        "-std=c++20",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-g",
        "${file}",
        "-o",
        "${workspaceFolder}/build/${fileBasenameNoExtension}"
    ],
    "group": {
        "kind": "build",
        "isDefault": true
    },
    "problemMatcher": ["$gcc"]
    }
]
}
